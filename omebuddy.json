{
  "format_version": "1.21.0",

  "minecraft:entity": {
    "description": {
      "identifier": "omenaso:omebuddy",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,

      "properties": {

        "omenaso:state": {
          "type": "int",
          "client_sync": true,
          "default": 0,
          "range": [0, 2]
        },

        "omenaso:emotion": {
          "type": "int",
          "client_sync": true,
          "default": 0,
          "range": [0, 3]
        }
      }
    },

    "component_groups": {

      "omenaso:state_companion": {

        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.8
        },

        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 8,
          "probability": 0.02
        },

        "minecraft:behavior.random_look_around": {
          "priority": 8
        },

        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "speed_multiplier": 1.1,
          "track_target": true
        }
      },

      "omenaso:state_agitated": {

        "minecraft:behavior.look_at_player": {
          "priority": 2,
          "look_distance": 16,
          "probability": 0.9
        },

        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "speed_multiplier": 1.3,
          "track_target": true
        }
      },

      "omenaso:state_transforming": {

        "minecraft:movement": {
          "value": 0
        },

        "minecraft:knockback_resistance": {
          "value": 1
        }
      }
    },

    "components": {

      "minecraft:type_family": {
        "family": [
          "omebuddy",
          "mob"
        ]
      },

      "minecraft:health": {
        "value": 100,
        "max": 100
      },

      "minecraft:attack": {
        "damage": 6
      },

      "minecraft:movement": {
        "value": 0.28
      },

      "minecraft:follow_range": {
        "value": 32
      },

      "minecraft:collision_box": {
        "width": 0.7,
        "height": 2
      },

      "minecraft:physics": {
        "has_gravity": true,
        "has_collision": true
      },

      "minecraft:movement.basic": {},

      "minecraft:jump.static": {},

      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "can_pass_doors": true,
        "can_open_doors": true
      },

      "minecraft:behavior.float": {
        "priority": 0
      },

      "minecraft:nameable": {}
    },

    "events": {

      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "omenaso:state_companion"
          ]
        }
      },

      "omenaso:set_state_companion": {

        "remove": {
          "component_groups": [
            "omenaso:state_agitated",
            "omenaso:state_transforming"
          ]
        },

        "add": {
          "component_groups": [
            "omenaso:state_companion"
          ]
        }
      },

      "omenaso:set_state_agitated": {

        "remove": {
          "component_groups": [
            "omenaso:state_companion",
            "omenaso:state_transforming"
          ]
        },

        "add": {
          "component_groups": [
            "omenaso:state_agitated"
          ]
        }
      },

      "omenaso:set_state_transforming": {

        "remove": {
          "component_groups": [
            "omenaso:state_companion",
            "omenaso:state_agitated"
          ]
        },

        "add": {
          "component_groups": [
            "omenaso:state_transforming"
          ]
        }
      }
    }
  }
}