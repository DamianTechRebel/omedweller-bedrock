{
  "format_version": "1.21.0",

  "minecraft:entity": {
    "description": {
      "identifier": "omenaso:omedweller",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {

      "omenaso:active": {

        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,

          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },

              "max_dist": 32
            }
          ]
        },

        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 1.2,
          "track_target": true
        },

        "minecraft:behavior.move_towards_target": {
          "priority": 3,
          "speed_multiplier": 1.1
        }
      },

      "omenaso:respawning": {

        "minecraft:movement": {
          "value": 0
        },

        "minecraft:knockback_resistance": {
          "value": 1
        }
      }
    },

    "components": {

      "minecraft:type_family": {
        "family": [
          "omedweller",
          "monster"
        ]
      },

      "minecraft:health": {
        "value": 500,
        "max": 500
      },

      "minecraft:attack": {
        "damage": 12
      },

      "minecraft:movement": {
        "value": 0.3
      },

      "minecraft:follow_range": {
        "value": 32
      },

      "minecraft:collision_box": {
        "width": 0.8,
        "height": 2.8
      },

      "minecraft:physics": {
        "has_gravity": true,
        "has_collision": true
      },

      "minecraft:movement.basic": {},

      "minecraft:jump.static": {},

      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "can_pass_doors": true,
        "can_open_doors": true
      },

      "minecraft:behavior.float": {
        "priority": 0
      },

      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.6
      },

      "minecraft:behavior.random_look_around": {
        "priority": 8
      },

      "minecraft:nameable": {}
    },

    "events": {

      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "omenaso:active"
          ]
        }
      },

      "omenaso:set_active": {
        "remove": {
          "component_groups": [
            "omenaso:respawning"
          ]
        },

        "add": {
          "component_groups": [
            "omenaso:active"
          ]
        }
      },

      "omenaso:set_respawning": {
        "remove": {
          "component_groups": [
            "omenaso:active"
          ]
        },

        "add": {
          "component_groups": [
            "omenaso:respawning"
          ]
        }
      }
    }
  }
}